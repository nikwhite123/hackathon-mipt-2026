DATABASE_URL=postgresql+psycopg2://app_user:app_password@localhost:5433/rostelecom_db
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Логи: LOG_LEVEL=DEBUG|INFO|WARNING|ERROR ; LOG_FORMAT=text|json
LOG_LEVEL=INFO
LOG_FORMAT=text
ENABLE_METRICS=true

# Схема БД — только Alembic; при старте API: upgrade head + сиды (локально и в Docker)
WAIT_FOR_DB=true
RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true
DB_WAIT_MAX_SECONDS=120
DB_WAIT_INTERVAL_SECONDS=2
